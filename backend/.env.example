# ============================================================
# FreshCheck AI — Backend environment variables
# Copy this file to backend/.env and fill in your values.
# Never commit the real .env file to version control.
# ============================================================

# Set to true during development for verbose logging
DEBUG=false

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum upload file size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Confidence threshold below which the model returns "Unable to assess" (0-1)
CONFIDENCE_THRESHOLD=0.60

# Image quality thresholds
BLUR_THRESHOLD=80.0

# Model file names (relative to backend/saved_models/)
MODEL_FILENAME=freshcheck_model.keras
LABELS_FILENAME=labels.json
MODEL_VERSION=1.0.0
