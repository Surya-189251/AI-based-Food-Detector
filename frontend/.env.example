# ============================================================
# FreshCheck AI — Frontend environment variables
# Copy this file to frontend/.env and adjust if needed.
# ============================================================

# Backend API base URL.
# Leave empty to use Vite's dev-server proxy (recommended for local dev).
# Set to your deployed backend URL for production, e.g.:
#   VITE_API_BASE_URL=https://your-backend.example.com
VITE_API_BASE_URL=
